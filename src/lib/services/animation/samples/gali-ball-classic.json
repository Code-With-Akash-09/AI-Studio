    "lines": [
        {
            "speaker": "raazu",
            "text": "दोस्तों, गोलू की खोई गेंद हर सुबह अपने आप घर लौट आती है!",
            "roman": "Doston, Golu ki khoi gend har subah apne aap ghar laut aati hai!",
            "expression": "curious",
            "pose": "point",
            "look": "camera",
            "listener": {
                "expression": "scared",
                "pose": "idle"
            },
            "camera": "wide"
        },
        {
            "speaker": "golu",
            "text": "भाई, ज़रूर कोई भूत रात को क्रिकेट खेलता है!",
            "roman": "Bhai, zaroor koi bhoot raat ko cricket khelta hai!",
            "expression": "scared",
            "pose": "scared",
            "listener": {
                "expression": "neutral",
                "pose": "idle"
            },
            "camera": "speaker"
        },
        {
            "speaker": "raazu",
            "text": "भूत? गोलू, भूत को तो बल्ला पकड़ना भी नहीं आता।",
            "roman": "Bhoot? Golu, bhoot ko toh balla pakadna bhi nahin aata.",
            "expression": "suspicious",
            "pose": "hips",
            "listener": {
                "expression": "scared",
                "pose": "idle"
            },
            "camera": "wide",
            "pauseAfter": 0.25
        },
        {
            "speaker": "golu",
            "text": "तो फिर भूत को कोचिंग चाहिए!",
            "roman": "Toh phir bhoot ko coaching chahiye!",
            "expression": "laughing",
            "pose": "laugh",
            "listener": {
                "expression": "suspicious",
                "pose": "hips"
            },
            "beat": "humor",
            "reaction": {
                "expression": "dizzy",
                "pose": "facefault",
                "text": "धड़ाम!"
            },
            "camera": "wide"
        },
        {
            "speaker": "raazu",
            "text": "देखो, गेंद पर ये छोटे-छोटे दाँतों के निशान हैं।",
            "roman": "Dekho, gend par ye chhote-chhote daanton ke nishaan hain.",
