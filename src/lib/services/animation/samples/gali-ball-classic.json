            "pose": "think",
            "listener": {
                "expression": "curious",
                "pose": "idle"
            },
            "camera": "speaker"
        },
        {
            "speaker": "golu",
            "text": "दाँत?! मतलब भूत के दाँत भी हैं?!",
            "roman": "Daant?! Matlab bhoot ke daant bhi hain?!",
            "expression": "shocked",
            "pose": "scared",
            "listener": {
                "expression": "neutral",
                "pose": "idle"
            },
            "camera": "closeup",
            "pauseAfter": 0.4
